# Copy this file to backend/.env and fill in real values.
# backend/.env must never be committed — add it to .gitignore.

DJANGO_SECRET_KEY=generate-a-new-random-key-do-not-reuse-any-key-shared-elsewhere
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_LOG_LEVEL=INFO

DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SECURE=False

DATABASE_NAME=zaytun
DATABASE_USER=replace_me
DATABASE_PASSWORD=replace_me
DATABASE_HOST=localhost
DATABASE_PORT=3306
